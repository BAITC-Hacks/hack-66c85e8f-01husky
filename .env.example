# Local development defaults. Copy this file to .env before starting Compose.
POSTGRES_DB=protocol
POSTGRES_USER=protocol
POSTGRES_PASSWORD=protocol
DATABASE_URL=postgresql+psycopg://protocol:protocol@postgres:5432/protocol
REDIS_URL=redis://redis:6379/0

APP_NAME=Kenes AI API
# Optional organization name in the protocol header.
ORGANIZATION_NAME=
DEBUG=false
SECRET_KEY=change-me-before-deployment
ACCESS_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
DATA_DIR=/app/backend/data
OUTBOX_DIR=/app/backend/outbox

PIPELINE_FAKE=1
STT_BACKEND=local
STT_MODEL=large-v3-turbo
# STT_MODEL_DIR=/absolute/path/to/pipeline/.models
STT_LANGUAGE=auto
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
# Two local ONNX models, prepared with python -m pipeline.download_diarization_models
# DIARIZATION_MODEL_DIR=/absolute/path/to/pipeline/.models/diarization
DIARIZATION_CPU_THREADS=4
DIARIZATION_THRESHOLD=0.5
# Set only if the true number of speaking people is known. Otherwise leave unset.
# DIARIZATION_NUM_SPEAKERS=3
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
OLLAMA_URL=http://ollama:11434
HF_TOKEN=
DUE_SOON_HOURS=24

# Bot callbacks use short-lived per-meeting tokens signed with SECRET_KEY.
# The legacy global BOT_API_TOKEN is no longer accepted.
PUBLIC_API_URL=http://api:8000/api/v1
BOT_TIMEOUT_SEC=10800
BOT_LOBBY_TIMEOUT_SEC=600
BOT_UPLOAD_TIMEOUT_SEC=120
BOT_MAX_RECORDING_SEC=7200
BOT_AUDIO_DEVICE=pulse:kenes.monitor
