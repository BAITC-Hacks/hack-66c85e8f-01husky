# Local development defaults. Copy this file to .env before starting Compose.
POSTGRES_DB=protocol
POSTGRES_USER=protocol
POSTGRES_PASSWORD=protocol
DATABASE_URL=postgresql+psycopg://protocol:protocol@postgres:5432/protocol
REDIS_URL=redis://redis:6379/0

APP_NAME=Meeting Protocol API
DEBUG=false
SECRET_KEY=change-me-before-deployment
ACCESS_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
DATA_DIR=/app/backend/data
OUTBOX_DIR=/app/backend/outbox

PIPELINE_FAKE=1
STT_BACKEND=local
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
OLLAMA_URL=http://ollama:11434
HF_TOKEN=
NVIDIA_API_KEY=
OPENAI_API_KEY=
DUE_SOON_HOURS=24

# Bot upload callback inside Compose. Change both dev secrets before deployment.
BOT_API_TOKEN=change-me-bot-token
PUBLIC_API_URL=http://api:8000/api/v1
BOT_TIMEOUT_SEC=10800

# Frontend (browser-side URL of the API)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
