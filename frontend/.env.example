# Backend FastAPI origin (server-side rewrite target for /api/v1/*)
BACKEND_URL=http://localhost:8000
# WebSocket origin for live recording (Next rewrites do not proxy WS).
# Use the same hostname you open the app on (localhost vs 127.0.0.1), or the auth cookie won't be sent.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# 1 = run entirely on MSW mocks from ./mocks (same as `pnpm mock`)
NEXT_PUBLIC_API_MOCKING=0
